# Copy this file to .env and replace every production secret.
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=replace-with-at-least-48-random-characters
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Local, zero-configuration database and private image storage.
DATABASE_PATH=db.sqlite3
# Set DATABASE_URL to use PostgreSQL (for example, Neon) instead of SQLite.
# DATABASE_URL=
PRIVATE_STORAGE_ROOT=storage
PUBLIC_BASE_URL=http://localhost:8000

ADMIN_USERNAME=eventadmin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# disabled | replicate | fashn | openai
AI_PROVIDER=disabled
AI_API_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
REPLICATE_MODEL_OWNER=cuuupid
REPLICATE_MODEL_NAME=idm-vton
REPLICATE_MODEL_VERSION=
FASHN_API_BASE_URL=https://api.fashn.ai/v1
FASHN_MODEL_NAME=tryon-v1.6
GENERATION_WORKERS=2
GENERATION_TIMEOUT_SECONDS=150
GENERATION_MAX_RETRIES=2

MAX_UPLOAD_MB=12
MAX_IMAGE_PIXELS=24000000
GUEST_SESSION_MINUTES=30
DOWNLOAD_TOKEN_MINUTES=1440
